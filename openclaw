#!/bin/bash
# ============================================================================
# OpenClaw 统一管理脚本
#
# 管理 ThunderLLAMA + Clawgate，使用全局配置
# ============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${OPENCLAW_CONFIG:-$HOME/.openclaw/config.yaml}"

# ============================================================================
# 颜色输出
# ============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() { echo -e "${BLUE}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✓${NC} $1"; }
warning() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; }

# ============================================================================
# 配置检查
# ============================================================================

check_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        error "Config file not found: $CONFIG_FILE"
        echo ""
        echo "Please create the config file:"
        echo "  mkdir -p ~/.openclaw"
        echo "  cp $SCRIPT_DIR/clawgate-integration/config.yaml.example ~/.openclaw/config.yaml"
        echo "  vim ~/.openclaw/config.yaml"
        exit 1
    fi
}

# ============================================================================
# 依赖检查
# ============================================================================

check_deps() {
    # 检查 Python
    if ! command -v python3 &> /dev/null; then
        error "Python3 not found"
        exit 1
    fi

    # 检查 PyYAML
    if ! python3 -c "import yaml" 2>/dev/null; then
        warning "PyYAML not installed"
        info "Installing PyYAML..."
        pip3 install --break-system-packages -q pyyaml
    fi

    # 检查 ThunderLLAMA
    if [ ! -f "$SCRIPT_DIR/build/bin/llama-server" ]; then
        error "ThunderLLAMA not built"
        echo "Please build ThunderLLAMA first:"
        echo "  cd $SCRIPT_DIR"
        echo "  mkdir -p build && cd build"
        echo "  cmake .. && make llama-server -j8"
        exit 1
    fi
}

# ============================================================================
# 命令实现
# ============================================================================

cmd_config() {
    check_config
    python3 "$SCRIPT_DIR/clawgate-integration/config_loader.py" show
}

cmd_start() {
    check_config
    check_deps

    info "Starting ThunderLLAMA from global config..."
    bash "$SCRIPT_DIR/scripts/load_config.sh" start
}

cmd_stop() {
    check_config
    bash "$SCRIPT_DIR/scripts/load_config.sh" stop
}

cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

cmd_bench() {
    check_config
    check_deps

    info "Running performance benchmark..."

    cd "$SCRIPT_DIR/clawgate-integration"

    # 加载配置到环境变量
    eval "$(python3 -c "
from config_loader import load_config
config = load_config()
for k, v in config.to_env_vars().items():
    print(f'export {k}=\"{v}\"')
")"

    # 运行测试
    python3 benchmark_lmcache_proper.py
}

cmd_test() {
    cmd_start
    sleep 5
    cmd_bench
}

cmd_status() {
    check_config

    LOG_DIR=$(python3 -c "from config_loader import load_config; print(load_config().server['log_dir'])" 2>/dev/null)
    PID_FILE="$LOG_DIR/llama-server.pid"

    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            success "ThunderLLAMA running (PID: $PID)"

            # 检查健康状态
            URL=$(python3 -c "from config_loader import load_config; print(load_config().thunderllama_url)")
            if curl -s "$URL/health" > /dev/null 2>&1; then
                success "Server responding at $URL"
            else
                warning "Server not responding at $URL"
            fi
        else
            warning "ThunderLLAMA not running (stale PID)"
        fi
    else
        error "ThunderLLAMA not running"
    fi
}

cmd_logs() {
    check_config

    LOG_DIR=$(python3 -c "from config_loader import load_config; print(load_config().server['log_dir'])")
    LOG_FILE="$LOG_DIR/llama-server.log"

    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        error "Log file not found: $LOG_FILE"
    fi
}

cmd_edit() {
    ${EDITOR:-vim} "$CONFIG_FILE"
}

# ============================================================================
# 主函数
# ============================================================================

case "${1:-help}" in
    config|show)
        cmd_config
        ;;

    start)
        cmd_start
        ;;

    stop)
        cmd_stop
        ;;

    restart)
        cmd_restart
        ;;

    bench|benchmark)
        cmd_bench
        ;;

    test)
        cmd_test
        ;;

    status)
        cmd_status
        ;;

    logs)
        cmd_logs
        ;;

    edit)
        cmd_edit
        ;;

    help|*)
        cat <<EOF
${BLUE}OpenClaw${NC} - Unified Management Script

${GREEN}Usage:${NC}
  ./openclaw <command>

${GREEN}Commands:${NC}
  config   - Show current configuration
  start    - Start ThunderLLAMA server
  stop     - Stop ThunderLLAMA server
  restart  - Restart server
  bench    - Run performance benchmark
  test     - Start server and run benchmark
  status   - Check server status
  logs     - Show server logs (follow)
  edit     - Edit global config file
  help     - Show this help

${GREEN}Configuration:${NC}
  Global config: ${YELLOW}$CONFIG_FILE${NC}

  To use custom config:
    ${BLUE}OPENCLAW_CONFIG=/path/to/config.yaml ./openclaw start${NC}

${GREEN}Examples:${NC}
  ./openclaw config          # View configuration
  ./openclaw start           # Start server
  ./openclaw test            # Start and benchmark
  ./openclaw edit            # Edit config
  ./openclaw logs            # Watch logs

${GREEN}First time setup:${NC}
  1. Create config: ${YELLOW}mkdir -p ~/.openclaw${NC}
  2. Copy template: ${YELLOW}cp clawgate-integration/config.yaml.example ~/.openclaw/config.yaml${NC}
  3. Edit config:   ${YELLOW}./openclaw edit${NC}
  4. Start server:  ${YELLOW}./openclaw start${NC}

${BLUE}Documentation:${NC}
  - Global config reference: ~/.openclaw/config.yaml
  - ThunderLLAMA docs: docs/
  - Clawgate docs: clawgate-integration/README.md

EOF
        ;;
esac
